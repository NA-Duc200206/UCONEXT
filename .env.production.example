# Copy to .env and replace __GEN__ values with cryptographically random secrets (>= 32 chars):
#   openssl rand -hex 32

NODE_ENV=production
FRONTEND_PORT=3000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=

# Database & Redis credentials (required by docker-compose.yml)
MONGO_ROOT_USER=uconext_admin
MONGO_ROOT_PASSWORD=__GEN__
REDIS_PASSWORD=__GEN__

# Optional managed overrides (uncomment for Atlas / Upstash)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/uconext
# REDIS_URL=rediss://default:pass@host:6379

# Authentication secrets (minimum 32 random characters each)
JWT_SECRET=__GEN__
JWT_REFRESH_SECRET=__GEN__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seeding controls (never enable AUTO_SEED in production)
AUTO_SEED=false
ALLOW_PROD_SEED=false
# Required only when running explicit CLI seed in production (password >= 12 chars)
# SEED_ADMIN_EMAIL=admin@uconext.vn
# SEED_ADMIN_PASSWORD=

# VNPAY payment gateway (disabled by default until real merchant credentials are configured)
PAYMENTS_VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://uconext.vn/payment-result

# Transactional SMTP (required in production)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=no-reply@uconext.vn
SMTP_PASS=__GEN__
SMTP_FROM=UCONEXT <no-reply@uconext.vn>

# Optional integrations & Observability
LOG_LEVEL=info
HEALTH_READY_TOKEN=__GEN__
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
IMAGE_REGISTRY=ghcr.io/na-duc200206
IMAGE_TAG=sha-latest
FRONTEND_BIND_IP=127.0.0.1
TRUST_PROXY_HOPS=2
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
AI_PROVIDER=auto
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=
