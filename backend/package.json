{
  "name": "multi-product-store-backend",
  "version": "1.0.0",
  "description": "Backend API for Multi-product store",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync(p.join('dist','config'),{recursive:true});fs.copyFileSync(p.join('src','config','unsplashPools.json'),p.join('dist','config','unsplashPools.json'));\"",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "seed": "node dist/scripts/seed.js",
    "seed:dev": "ts-node-dev --transpile-only src/scripts/seed.ts",
    "seed:images": "ts-node-dev --transpile-only --no-notify src/scripts/fetchUnsplashImages.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@sentry/node": "^11.19.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "file-type": "^22.3.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.6.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qs": "^6.17.1",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.1.2",
    "mongodb-memory-server": "^11.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
