PORT=5000
CLIENT_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
MONGODB_URI=mongodb://localhost:27017/glowstore
REDIS_URL=redis://localhost:6379

# VNPAY Sandbox
VNPAY_TMN_CODE=2QXUBV54
VNPAY_HASH_SECRET=HJGBUYTREWQLKJHGFDSAZXCVBNMKIOP
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment-result

# Unsplash API
UNSPLASH_ACCESS_KEY=your_access_key_here

# AI Model API (required for AI Assistant & Product Insights)
# AI_PROVIDER: auto | gemini | openai | groq | openrouter | deepseek | ollama | openai-compatible
AI_PROVIDER=auto
# Optional universal overrides (take precedence over provider-specific defaults)
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_MS=25000
# AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Provider-specific keys (set at least one, or OLLAMA_BASE_URL for local models)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=MINIMAL

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# SMTP Email (optional in dev; falls back to console log when unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=UCONEXT <your_email@gmail.com>

# Firebase Authentication (server-side ID token verification)
FIREBASE_PROJECT_ID=your_firebase_project_id
