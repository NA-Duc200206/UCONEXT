{
  "name": "multi-product-store",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@types/express": "^4.17.21",
    "@grpc/grpc-js": "^1.14.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "lint": "eslint .",
    "format:check": "prettier --check eslint.config.js .prettierrc e2e/**/*.ts",
    "typecheck:backend": "npm run build --workspace=backend && npm run typecheck:tests --workspace=backend",
    "typecheck:frontend": "npm run typecheck --workspace=frontend",
    "test:backend": "npm test --workspace=backend",
    "test:backend:coverage": "npm run test:coverage --workspace=backend",
    "test:frontend": "npm test --workspace=frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "verify": "npm run lint && npm run format:check && npm run typecheck:backend && npm run typecheck:frontend && npm run test:backend:coverage && npm run test:frontend"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.74.0"
  }
}
